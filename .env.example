# dev-ai environment configuration
# Copy this file to .env and fill in your values:  copy .env.example .env

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_key_here

# Optional: use OpenRouter instead of OpenAI (uncomment both lines)
# OPENAI_API_KEY=sk-or-v1-your_key_here
# API_BASE_URL=https://openrouter.ai/api/v1

# Optional: override the OpenAI-compatible API base URL
# API_BASE_URL=https://api.openai.com/v1

# Optional: default LLM model used by the AI commands
# (managed by:  dev-ai config --model <name>)
# DEV_AI_MODEL=gpt-4o-mini

# Optional: language of the AI answers (e.g. en, ru)
# (managed by:  dev-ai config --lang <code>)
# DEV_AI_LANG=en
